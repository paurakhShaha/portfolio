    "@tiptap/starter-kit": "^3.33.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.1.16",
    "lucide-react": "^0.460.0",
    "mongoose": "^9.12.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
