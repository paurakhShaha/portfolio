{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is a plain static file.
    "run_worker_first": ["/api/*", "/blog", "/blog/*", "/sitemap.xml", "/robots.txt", "/google*"]
  },
  // Pings the API every 10 minutes so Render's free plan never puts it to sleep (worker/index.js `scheduled`).
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "paurakhshah.com.np", "custom_domain": true }],
  "vars": {
    // URL of the deployed Express API (Render/Railway/Fly), no trailing slash.
    "API_ORIGIN": "https://portfolio-4u4q.onrender.com"
  }
  // PROXY_SECRET is a secret: npx wrangler secret put PROXY_SECRET
}
