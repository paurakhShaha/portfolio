# Copy to .env (never commit .env). Used by the Express server in server/ only;
# none of these reach the browser bundle.

# MongoDB Atlas connection string (database name in the path, e.g. /portfolio)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Long random string, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public origin of the site (no trailing slash). Locally: the Vite dev server.
SITE_URL=http://localhost:5173

# Cloudinary (Dashboard → API Keys). Needed only for featured-image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=blog

# Bearer token for /api/publish (npm run post). Same value here and on the API host.
# Generate like JWT_SECRET. Leave empty to turn the publishing API off.
BLOG_API_TOKEN=
# Where npm run post sends posts (default http://localhost:8787). Live: https://paurakhshah.com.np
# BLOG_API_URL=

# Optional
# PORT=8787
# BLOG_AUTHOR=Paurakh Shah
# Production only: shared secret the static host's proxy sends in X-Proxy-Secret.
# PROXY_SECRET=
# Number of proxies in front of the API (Render/Railway/Fly: 1)
# TRUST_PROXY=1
